// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// Define the User roles
enum Role {
  USER
  ADMIN
}

model User {
  id    String  @id @default(cuid()) // Unique ID for the user
  name  String? // Optional user name
  email String  @unique // User's email, must be unique
  role  Role    @default(USER) // The user's role, defaults to USER

  posts Post[] // A user can have many posts
}

model Post {
  id        String   @id @default(cuid()) // Unique ID for the post
  title     String
  content   String   // The full content of the post in Markdown format
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id]) // Connects this post to a User
  authorId String // Foreign key that holds the User's ID
}